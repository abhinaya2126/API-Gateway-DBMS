          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.success && response.token) {\r",
                  "    pm.collectionVariables.set(\"token\", response.token);\r",
                  "    console.log(\"JWT token saved successfully\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
